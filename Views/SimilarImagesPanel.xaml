<UserControl x:Class="DupFree.Views.SimilarImagesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource AppBackground}"
    Foreground="{DynamicResource WindowForeground}">
    <UserControl.Resources>
        <!-- Rounded Slider Style -->
        <Style x:Key="RoundedSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Height="26">
                            <!-- Full-width track line that passes behind/through the thumb -->
                            <Border Background="#9CA3AF" Height="3" VerticalAlignment="Center" CornerRadius="1.5" Margin="0,0,0,0" />
                            <!-- Invisible Track for interaction and thumb positioning -->
                            <Track Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Height="26" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="22" Height="22">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="22" Height="22" 
                                                         Fill="White" 
                                                         Stroke="#CCCCCC" StrokeThickness="0.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Height="26" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Rounded ProgressBar Style -->
        <Style x:Key="RoundedProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid ClipToBounds="True">
                            <Border Name="PART_Track" Background="#374151" CornerRadius="5" Height="{TemplateBinding Height}" />
                            <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="5" Height="{TemplateBinding Height}" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressToWidthConverter}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top control bar (edge-to-edge like Scanned Files) -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource TopBarBackground}" Padding="16" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="DeleteSimilarSelectedButton" Click="DeleteSimilarSelectedButton_Click" Style="{StaticResource DangerButton}" Padding="20,8" Height="40" Margin="0,0,12,0">Delete Selected (0)</Button>

                    <TextBlock Text="Similarity:" Foreground="{DynamicResource ControlForeground}" Margin="12,0,8,0" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Slider -->
                            <Slider Name="MaxDistanceSlider" Minimum="75" Maximum="99" Value="84" Width="150" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Style="{StaticResource RoundedSliderStyle}"
                                    ValueChanged="MaxDistanceSlider_ValueChanged" ToolTip="Minimum SSIM similarity to group images. Higher = stricter matching." IsSnapToTickEnabled="True" TickFrequency="1" />
                            <!-- Percentage display -->
                            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                <TextBlock Name="MaxDistanceText" Text="84%" Foreground="{DynamicResource WindowForeground}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Name="StatusText" Text="" Foreground="{DynamicResource MutedForeground}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="240" Visibility="Visible" />
                    <TextBlock Name="ProgressLabel" Text="Progress" Foreground="{DynamicResource MutedForeground}" FontSize="11" VerticalAlignment="Center" Margin="8,0,6,0" Visibility="Collapsed" />
                    <Grid Name="SimilarScanProgressBarContainer" Width="150" Height="10" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Border Background="{DynamicResource SidebarBackground}" CornerRadius="5" BorderBrush="#4B5563" BorderThickness="1" />
                        <Border Name="SimilarScanProgressIndicator" Background="{DynamicResource ScanButtonBrush}" CornerRadius="4" Width="0" HorizontalAlignment="Left" Margin="1" />
                    </Grid>
                    <TextBlock Name="SimilarScanProgressText" Text="0%" Foreground="{DynamicResource MutedForeground}" FontSize="11" VerticalAlignment="Center" Margin="4,0,12,0" Visibility="Collapsed" />
                    <TextBlock Name="SimilarScanTimerText" Text="00:00" Foreground="{DynamicResource MutedForeground}" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" FontFamily="Consolas" FontWeight="SemiBold" />
                </StackPanel>

                <Button Name="ScanSimilarButton" Grid.Column="1" Click="ScanSimilarButton_Click" Style="{StaticResource PrimaryButton}" Padding="20,8" Height="40" HorizontalAlignment="Right">Scan</Button>
            </Grid>
        </Border>

        <!-- Action bar (auto-select + inline settings) -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource ActionBarBackground}" Padding="16,12" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="AutoSelectButton" Click="AutoSelectButton_Click" Style="{StaticResource SecondaryButton}" Padding="18,8" Height="36" Margin="0,0,12,0">Auto-Select</Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <CheckBox Name="AutoSelectKeepUncompressedCheckBox" Content="Uncompressed filetype" Margin="0,0,12,0" Style="{StaticResource SettingsCheckBox}" Checked="AutoSelectSettingsCheckBox_Changed" Unchecked="AutoSelectSettingsCheckBox_Changed" />
                    <CheckBox Name="AutoSelectKeepHigherResolutionCheckBox" Content="Lower resolution" Margin="0,0,12,0" Style="{StaticResource SettingsCheckBox}" Checked="AutoSelectSettingsCheckBox_Changed" Unchecked="AutoSelectSettingsCheckBox_Changed" />
                    <CheckBox Name="AutoSelectKeepLargerFilesizeCheckBox" Content="Smaller filesize" Margin="0,0,12,0" Style="{StaticResource SettingsCheckBox}" Checked="AutoSelectSettingsCheckBox_Changed" Unchecked="AutoSelectSettingsCheckBox_Changed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content: groups (left) -->
        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource AppBackground}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="16,8,8,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Name="SimilarGroupsItemsControl" ItemsSource="{Binding}" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <!-- Thumbnails (group row) -->
                                <ItemsControl ItemsSource="{Binding Images}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                                <Border Width="80" Height="80" CornerRadius="4" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" Margin="4" Cursor="Hand"
                                                    MouseLeftButtonDown="Thumbnail_MouseDown" MouseEnter="Thumbnail_MouseEnter">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                                <Setter Property="BorderThickness" Value="3" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                    <Border Name="SelectedOverlay" Background="#66FF0000" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False" />
                                                </Grid>
                                                <Border.ToolTip>
                                                    <ToolTip Content="{Binding FileName}" />
                                                </Border.ToolTip>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="SelectedOverlay" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Empty placeholder for no groups (left) -->
        <Grid Name="NoSimilarPlaceholder" Grid.Row="2" Grid.Column="0" IsHitTestVisible="False" Background="{DynamicResource AppBackground}" Margin="16,8,8,8" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75">
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource ControlBackground}" Margin="0,0,0,8">
                    <TextBlock Text="🖼" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" />
                </Border>
                <TextBlock Text="No similar images found" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="Click &quot;Scan&quot; to find similar images" HorizontalAlignment="Center" Foreground="{DynamicResource MutedForeground}" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Preview Pane (Right) -->
        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="8,8,16,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Preview" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}" Margin="0,0,0,12" />
                    <Border Width="350" Height="250" Background="{DynamicResource ControlBackground}" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,12">
                        <Image Name="PreviewImage" Stretch="Uniform" />
                    </Border>
                    <StackPanel Name="PreviewInfoPanel" Margin="0,0,0,16">
                        <TextBlock Name="PreviewFileName" Text="No image selected" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,8" />
                        <TextBlock Name="PreviewFilePath" Text="" FontSize="10" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Name="PreviewFileSize" Text="" FontSize="10" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,4" />
                        <TextBlock Name="PreviewDimensions" Text="" FontSize="10" Foreground="{DynamicResource MutedForeground}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                        <Button Name="ViewImageButton" Click="ViewImageButton_Click" Style="{StaticResource SecondaryButton}" Padding="16,8" Height="36" Margin="0,0,0,8">Open Image</Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
