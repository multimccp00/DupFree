<Window x:Class="DupFree.Views.UnexpectedErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unexpected Error" Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="An unexpected error has occurred.  A log file has been written to disk.\n" 
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" x:Name="LogPathText" TextWrapping="Wrap" Margin="0,4,0,0" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CopyButton" Content="Copy Log" Width="80" Margin="0,0,8,0" Click="CopyButton_Click" />
            <Button x:Name="OpenButton" Content="Open Log" Width="80" Margin="0,0,8,0" Click="OpenButton_Click" />
            <Button Content="Close" Width="80" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>